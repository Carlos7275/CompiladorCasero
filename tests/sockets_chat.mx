Socket servidor;
Entero puerto;
Socket cliente;
Socket conexion;
Cadena mensajeServidor = "";
Cadena mensajeCliente = "";

Para (Entero ronda = 0; ronda < 16; ronda++) {
    servidor = Socket.escuchar(0, 4);
    Si (servidor < 1) {
        Lanzar(UltimoError());
    }

    puerto = servidor.puertoLocal();
    cliente = Socket.conectar("127.0.0.1", puerto);
    conexion = servidor.aceptar();
    Si (cliente < 1 || conexion < 1) {
        Lanzar(UltimoError());
    }

    cliente.timeout(2000, 2000);
    conexion.timeout(2000, 2000);

    cliente.enviar("hola servidor");
    mensajeServidor = conexion.recibir(255);
    Si (Comparar(mensajeServidor, "hola servidor") != 0) {
        Lanzar("El servidor recibio un mensaje incorrecto.");
    }

    conexion.enviar("hola cliente");
    mensajeCliente = cliente.recibir(255);
    Si (Comparar(mensajeCliente, "hola cliente") != 0) {
        Lanzar("El cliente recibio un mensaje incorrecto.");
    }

    cliente.cerrar();
    conexion.cerrar();
    servidor.cerrar();
}

Mostrar("CHAT_OK: 16 conversaciones TCP completas; todos los sockets cerrados.\n");
