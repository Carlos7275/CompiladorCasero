Cadena url = "http://httpbin.org/get?lenguaje=mx&tipo=prueba";
Cadena headers = "Accept: application/json\nUser-Agent: Mx";
Cadena cuerpo_vacio = "";
HttpClient cliente;

Entero estado = cliente.request("GET", url, headers, cuerpo_vacio);
Cadena respuesta_headers = cliente.headers();
Cadena respuesta_body = cliente.body();

Mostrar("Estado: ", estado, "\n");
Mostrar("Cabeceras:\n", respuesta_headers, "\n");
Mostrar("JSON recibido:\n", respuesta_body, "\n");